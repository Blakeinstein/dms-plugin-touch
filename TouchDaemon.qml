import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Hyprland
import qs.Common
import qs.Services
import qs.Modules.Plugins
import "touchlua.js" as TouchLua
import "wvkbd.js" as Wvkbd
import "rotation.js" as Rotation
import "inputs.js" as Inputs

PluginComponent {
    id: root

    readonly property var log: Log.scoped("duxTouch")

    readonly property string sensorService: "net.hadess.SensorProxy"
    readonly property string sensorPath: "/net/hadess/SensorProxy"
    // wvkbd: SIGUSR1 hides, SIGUSR2 shows
    readonly property int sigHide: 10
    readonly property int sigShow: 12

    readonly property bool tabletMode: pluginData.tabletMode ?? false
    readonly property bool rotationLocked: pluginData.rotationLocked ?? false
    readonly property string keyboardBinary: pluginData.keyboardBinary || "wvkbd-mobintl"
    readonly property string keyboardBackend: pluginData.keyboardBackend || "wvkbd"
    readonly property string virtualKeyboardPluginId: "virtualKeyboard"
    readonly property string rotationOutput: pluginData.rotationOutput && pluginData.rotationOutput !== "auto" ? pluginData.rotationOutput : Rotation.defaultOutput(WlrOutputService.outputs)
    readonly property bool rotationActive: (pluginData.rotationEnabled ?? false) && !rotationLocked && DMSService.isConnected && DMSService.capabilities.includes("dbus") && WlrOutputService.wlrOutputAvailable

    // Whether the wvkbd binary itself resolves on PATH, independent of which backend is selected
    property bool wvkbdAvailable: false
    // Whether the sibling Virtual Keyboard plugin is installed and enabled
    readonly property bool virtualKeyboardAvailable: pluginService?.isPluginLoaded(virtualKeyboardPluginId) ?? false
    readonly property bool keyboardAvailable: keyboardBackend === "virtualKeyboard" ? virtualKeyboardAvailable : wvkbdAvailable
    property bool keyboardVisible: false

    readonly property bool physicalKeyboard: pluginData.physicalKeyboard ?? true
    readonly property bool autoTabletMode: physicalKeyboard && (pluginData.autoTabletMode ?? true)
    readonly property bool hideOnKeyPress: physicalKeyboard && (pluginData.hideOnKeyPress ?? true)
    readonly property bool followTabletSwitch: pluginData.followTabletSwitch ?? true
    readonly property bool showHideButton: pluginData.showHideButton ?? true
    // "", "udev" or "libinput"; libinput needs read access to /dev/input (the input group)
    property string inputTier: ""
    property bool udevadmAvailable: false
    // libinput debug-events watches every input device and costs CPU accordingly, so it needs explicit consent
    readonly property bool libinputWatcherEnabled: pluginData.libinputWatcherEnabled ?? false
    // What the resident watcher actually is right now ("", "udev" or "libinput"), independent of inputTier's raw capability
    property string activeWatcherMode: ""
    property var externalKeyboardNodes: []
    readonly property int externalKeyboardCount: externalKeyboardNodes.length
    readonly property bool inputWatchWanted: autoTabletMode || hideOnKeyPress || followTabletSwitch
    property bool _inputScanned: false
    property bool _restartVisible: false

    readonly property var keyboardOptions: ({
            "binary": keyboardBinary,
            "height": pluginData.keyboardHeight ?? 250,
            "landscapeHeight": pluginData.keyboardLandscapeHeight ?? 200,
            "layers": pluginData.keyboardLayers || "",
            "auto": tabletMode && !(physicalKeyboard && externalKeyboardCount > 0) && (pluginData.keyboardAuto ?? true),
            "radius": Theme.cornerRadius,
            "font": Theme.fontFamily,
            "fontSize": Theme.fontSizeLarge,
            "colors": (pluginData.keyboardFollowTheme ?? true) ? {
                "bg": Theme.surfaceContainer,
                "fg": Theme.surfaceContainerHigh,
                "fgSp": Theme.surfaceContainerHighest,
                "press": Theme.primaryContainer,
                "pressSp": Theme.primaryContainer,
                "swipe": Theme.primaryContainer,
                "swipeSp": Theme.primaryContainer,
                "text": Theme.surfaceText,
                "textSp": Theme.primary
            } : null
        })
    readonly property string keyboardCommand: JSON.stringify(Wvkbd.argv(keyboardOptions))
    property string _runningCommand: ""
    property bool _restartPending: false

    readonly property string touchLuaPath: HyprlandService.hyprDmsDir + "/touch.lua"
    readonly property string touchLua: {
        if (!HyprlandService.luaConfigActive)
            return "";
        if (!(pluginData.gesturesEnabled ?? true))
            return "-- Auto-generated by dux-touch — gestures are off\n";
        const bindings = Array.isArray(pluginData.bindings) ? pluginData.bindings : TouchLua.DEFAULT_BINDINGS;
        return TouchLua.generate(bindings, {
            "sensitivity": (pluginData.sensitivity ?? 40) / 10,
            "longPressDelay": pluginData.longPressDelay ?? 400,
            "edgeMargin": pluginData.edgeMargin ?? 10,
            "holdTouches": pluginData.holdTouches ?? true,
            "holdTouchesDelay": pluginData.holdTouchesDelay ?? 40,
            "workspaceSwipeTouch": pluginData.workspaceSwipeTouch ?? true
        });
    }

    property string _sensorSubscription: ""
    property int _desiredTransform: -1
    property bool _applyingRotation: false

    onKeyboardBinaryChanged: {
        Proc.runCommand("duxtouch-wvkbd-check", ["sh", "-c", 'command -v "$1"', "sh", keyboardBinary], (output, exitCode) => {
            wvkbdAvailable = exitCode === 0;
            if (!wvkbdAvailable)
                log.info("On-screen keyboard not found:", keyboardBinary);
            Qt.callLater(reconcileKeyboard);
        });
    }
    onKeyboardBackendChanged: {
        if (keyboardBackend === "virtualKeyboard")
            keyboardVisible = pluginService?.getGlobalVar(virtualKeyboardPluginId, "open", false) ?? false;
        else
            keyboardVisible = false;
        Qt.callLater(reconcileKeyboard);
    }
    onTabletModeChanged: Qt.callLater(reconcileKeyboard)
    onKeyboardCommandChanged: Qt.callLater(reconcileKeyboard)
    onTouchLuaChanged: Qt.callLater(writeTouchLua)
    onRotationActiveChanged: rotationActive ? startRotation() : stopRotation()
    onInputWatchWantedChanged: syncInputWatcher()
    onLibinputWatcherEnabledChanged: syncInputWatcher()
    onRotationOutputChanged: applyRotation()

    function toggle() {
        toggleKeyboard();
    }

    function toggleKeyboard() {
        if (keyboardVisible)
            hideKeyboard();
        else
            showKeyboard();
    }

    function showKeyboard() {
        if (!keyboardAvailable) {
            ToastService.showError(I18n.trFor("duxTouch", "On-screen keyboard not found"), keyboardBackend === "virtualKeyboard" ? I18n.trFor("duxTouch", "Virtual Keyboard plugin") : keyboardBinary);
            return;
        }
        if (keyboardBackend === "virtualKeyboard") {
            pluginService?.setGlobalVar(virtualKeyboardPluginId, "open", true);
            keyboardVisible = true;
            return;
        }
        if (osk.running && tabletMode)
            osk.signal(sigShow);
        keyboardVisible = true;
        Qt.callLater(reconcileKeyboard);
    }

    function hideKeyboard() {
        if (keyboardBackend === "virtualKeyboard") {
            pluginService?.setGlobalVar(virtualKeyboardPluginId, "open", false);
            keyboardVisible = false;
            return;
        }
        if (osk.running && tabletMode)
            osk.signal(sigHide);
        keyboardVisible = false;
        Qt.callLater(reconcileKeyboard);
    }

    // A manual change takes ownership away from automatic tablet mode
    function setTabletMode(enabled) {
        pluginService?.savePluginState(pluginId, "tabletModeManaged", false);
        applyTabletMode(enabled);
    }

    function applyTabletMode(enabled) {
        if (!enabled) {
            if (keyboardBackend === "virtualKeyboard")
                pluginService?.setGlobalVar(virtualKeyboardPluginId, "open", false);
            keyboardVisible = false;
        }
        pluginService?.savePluginData(pluginId, "tabletMode", enabled);
    }

    function setRotationLocked(locked) {
        pluginService?.savePluginData(pluginId, "rotationLocked", locked);
    }

    function setOption(key, value) {
        if (key === "tabletMode") {
            setTabletMode(value);
            return;
        }
        pluginService?.savePluginData(pluginId, key, value);
    }

    function wantTablet(want) {
        if (!autoTabletMode && !followTabletSwitch)
            return;
        const next = Inputs.tabletDecision(want, {
            "tabletMode": tabletMode,
            "managed": pluginService?.loadPluginState(pluginId, "tabletModeManaged", false) ?? false
        });
        if (!next)
            return;
        pluginService?.savePluginState(pluginId, "tabletModeManaged", next.managed);
        applyTabletMode(next.tabletMode);
    }

    function scanInputs() {
        Proc.runCommand("duxtouch-input-scan", ["sh", "-c", Inputs.SCAN_SCRIPT], (output, exitCode) => {
            const nodes = Inputs.externalKeyboards(output).map(d => d.node);
            const before = _inputScanned ? externalKeyboardCount : (pluginService?.loadPluginState(pluginId, "externalKeyboards", -1) ?? -1);
            _inputScanned = true;
            externalKeyboardNodes = nodes;
            pluginService?.savePluginState(pluginId, "externalKeyboards", nodes.length);
            // Only transitions count, so a laptop whose keyboard never detaches is never pushed into tablet mode
            if (before < 0 || (before > 0) === (nodes.length > 0))
                return;
            if (!physicalKeyboard)
                return;
            if (nodes.length > 0) {
                hideKeyboard();
                if (autoTabletMode)
                    wantTablet(false);
            } else if (autoTabletMode) {
                wantTablet(true);
            }
        }, 300);
    }

    function handleInputLine(line) {
        if (activeWatcherMode === "udev") {
            if (/\b(add|remove)\b/.test(line))
                scanInputs();
            return;
        }
        const event = Inputs.parseLibinputLine(line);
        if (!event)
            return;
        switch (event.type) {
        case "devices":
            scanInputs();
            break;
        case "key":
            if (hideOnKeyPress && keyboardVisible && externalKeyboardNodes.includes(event.node))
                hideKeyboard();
            break;
        case "tabletSwitch":
            if (followTabletSwitch)
                wantTablet(event.on);
            break;
        }
    }

    function detectInputTier() {
        // One shot, so inputTier and udevadmAvailable land together: syncInputWatcher must see both
        // at once, or it could briefly start the heavy libinput watcher before learning udevadm exists.
        const script = 'tier=""; command -v libinput >/dev/null 2>&1 && for e in /dev/input/event*; do [ -r "$e" ] && { tier=libinput; break; }; done; [ -z "$tier" ] && command -v udevadm >/dev/null 2>&1 && tier=udev; udevadm_ok=0; command -v udevadm >/dev/null 2>&1 && udevadm_ok=1; printf "%s\\n%s\\n" "$tier" "$udevadm_ok"';
        Proc.runCommand("duxtouch-input-tier", ["sh", "-c", script], output => {
            const lines = output.split("\n");
            inputTier = (lines[0] ?? "").trim();
            udevadmAvailable = lines[1]?.trim() === "1";
            syncInputWatcher();
        });
    }

    // libinput debug-events opens every input device and costs CPU proportional to all input (pointer
    // and touch motion included), so it only runs with explicit consent. Otherwise, hotplug detection
    // alone falls back to the much cheaper udevadm monitor, which can't see key presses or the tablet
    // switch (see handleInputLine). libinput still runs unopted-in as a last resort, when udevadm itself
    // is missing, since hotplug detection would otherwise be unavailable entirely.
    function syncInputWatcher() {
        const wanted = inputWatchWanted && inputTier !== "";
        if (!wanted) {
            stopInputWatcher();
            return;
        }
        const mode = inputTier === "libinput" && (libinputWatcherEnabled || !udevadmAvailable) ? "libinput" : "udev";
        if (inputWatcher.running) {
            if (activeWatcherMode === mode)
                return;
            stopInputWatcher();
        }
        activeWatcherMode = mode;
        scanInputs();
        if (mode === "libinput")
            inputWatcher.command = ["sh", "-c", "libinput debug-events 2>/dev/null | grep --line-buffered -E 'DEVICE_(ADDED|REMOVED)|KEYBOARD_KEY|SWITCH_TOGGLE'"];
        else
            inputWatcher.command = ["udevadm", "monitor", "--udev", "--subsystem-match=input"];
        inputWatcher.running = true;
    }

    // The libinput pipeline runs under sh, so its children are stopped by parent pid
    function stopInputWatcher() {
        if (!inputWatcher.running)
            return;
        if (inputWatcher.processId > 0)
            Quickshell.execDetached(["pkill", "-P", String(inputWatcher.processId)]);
        inputWatcher.running = false;
    }

    // Outside tablet mode wvkbd only exists while shown; in tablet mode it stays resident and is shown by signal
    function reconcileKeyboard() {
        if (keyboardBackend !== "wvkbd") {
            osk.running = false;
            return;
        }
        if (_restartPending)
            return;
        const wanted = keyboardAvailable && (tabletMode || keyboardVisible);
        if (!wanted) {
            osk.running = false;
            return;
        }
        if (osk.running) {
            if (_runningCommand === keyboardCommand)
                return;
            _restartVisible = keyboardVisible;
            _restartPending = true;
            osk.running = false;
            return;
        }
        const args = Wvkbd.argv(Object.assign({}, keyboardOptions, {
            "hidden": !keyboardVisible
        }));
        _runningCommand = keyboardCommand;
        osk.command = args;
        osk.running = true;
    }

    function writeTouchLua() {
        if (!touchLua)
            return;
        // exit 3 = unchanged, so a shell start does not reload Hyprland for nothing
        const script = 'mkdir -p "${2%/*}" && printf "%s" "$1" > "$2.tmp" && if cmp -s "$2.tmp" "$2"; then rm -f "$2.tmp"; exit 3; fi; mv -f "$2.tmp" "$2"';
        Proc.runCommand("duxtouch-write-lua", ["sh", "-c", script, "sh", touchLua, touchLuaPath], (output, exitCode) => {
            if (exitCode === 3)
                return;
            if (exitCode !== 0) {
                log.warn("Failed to write", touchLuaPath, output);
                return;
            }
            HyprlandService.reloadConfig();
        });
    }

    function startRotation() {
        DMSService.dbusCall("system", sensorService, sensorPath, sensorService, "ClaimAccelerometer", [], response => {
            if (response.error) {
                log.warn("ClaimAccelerometer failed:", response.error);
                return;
            }
            if (!rotationActive) {
                releaseAccelerometer();
                return;
            }
            DMSService.dbusSubscribe("system", sensorService, sensorPath, "org.freedesktop.DBus.Properties", "PropertiesChanged", subscribed => {
                const id = subscribed.result?.subscriptionId ?? "";
                if (!rotationActive) {
                    if (id)
                        DMSService.dbusUnsubscribe(id);
                    return;
                }
                _sensorSubscription = id;
            });
            readOrientation();
        });
    }

    function stopRotation() {
        if (_sensorSubscription)
            DMSService.dbusUnsubscribe(_sensorSubscription);
        _sensorSubscription = "";
        _desiredTransform = -1;
        releaseAccelerometer();
    }

    function releaseAccelerometer() {
        if (DMSService.isConnected)
            DMSService.dbusCall("system", sensorService, sensorPath, sensorService, "ReleaseAccelerometer", []);
    }

    // Read the property back rather than trusting the signal body's variant encoding
    function readOrientation() {
        DMSService.dbusGetProperty("system", sensorService, sensorPath, sensorService, "AccelerometerOrientation", response => {
            const transform = Rotation.transformFor(response.result?.value);
            if (transform === null || !rotationActive)
                return;
            _desiredTransform = transform;
            applyRotation();
        });
    }

    function applyRotation() {
        if (!rotationActive || _desiredTransform < 0 || _applyingRotation)
            return;
        const heads = Rotation.headsWithTransform(WlrOutputService.outputs, rotationOutput, _desiredTransform);
        if (!heads)
            return;
        _applyingRotation = true;
        WlrOutputService.applyConfiguration(heads, () => {
            _applyingRotation = false;
        });
    }

    Process {
        id: osk

        onExited: (exitCode, exitStatus) => {
            if (root._restartPending) {
                root._restartPending = false;
                root.keyboardVisible = root._restartVisible;
                Qt.callLater(root.reconcileKeyboard);
                return;
            }
            // No respawn here: a bad flag would otherwise loop. The next show starts it again.
            if (exitStatus === 0 && exitCode !== 0)
                root.log.warn("wvkbd exited with code", exitCode);
            root.keyboardVisible = false;
        }
    }

    Process {
        id: inputWatcher

        stdout: SplitParser {
            onRead: line => root.handleInputLine(line)
        }

        onExited: (exitCode, exitStatus) => {
            if (exitStatus === 0 && exitCode !== 0)
                root.log.warn("Input watcher exited with code", exitCode);
        }
    }

    // wvkbd destroys its layer surface when hidden, so these events are its real visibility, including --auto
    Connections {
        target: CompositorService.isHyprland && root.keyboardBackend === "wvkbd" ? Hyprland : null

        function onRawEvent(event) {
            if (event.data !== "wvkbd" || root._restartPending)
                return;
            if (event.name === "openlayer")
                root.keyboardVisible = true;
            else if (event.name === "closelayer")
                root.keyboardVisible = false;
        }
    }

    // The Virtual Keyboard plugin brings its own hide affordance (DankBar pill), so the floating hide button is wvkbd-only
    LazyLoader {
        active: root.keyboardBackend === "wvkbd" && root.keyboardVisible && root.showHideButton
        KeyboardBar {
            daemon: root
        }
    }

    Connections {
        target: root.pluginService
        enabled: root.keyboardBackend === "virtualKeyboard"
        function onGlobalVarChanged(pluginId, varName) {
            if (pluginId === root.virtualKeyboardPluginId && varName === "open")
                root.keyboardVisible = root.pluginService.getGlobalVar(root.virtualKeyboardPluginId, "open", false);
        }
    }

    Connections {
        target: DMSService
        function onDbusSignalReceived(subscriptionId, data) {
            if (subscriptionId && subscriptionId === root._sensorSubscription)
                root.readOrientation();
        }
    }

    // Hyprland re-applies outputs.lua on reload, which undoes the rotation
    Connections {
        target: WlrOutputService
        function onStateChanged() {
            root.applyRotation();
        }
    }

    IpcHandler {
        target: "duxTouch"

        function toggleKeyboard(): string {
            root.toggleKeyboard();
            return root.keyboardVisible ? "shown" : "hidden";
        }

        function showKeyboard(): string {
            root.showKeyboard();
            return root.keyboardVisible ? "shown" : "hidden";
        }

        function hideKeyboard(): string {
            root.hideKeyboard();
            return "hidden";
        }

        function setTabletMode(enabled: bool): string {
            root.setTabletMode(enabled);
            return enabled ? "on" : "off";
        }

        function toggleTabletMode(): string {
            root.setTabletMode(!root.tabletMode);
            return root.tabletMode ? "on" : "off";
        }

        function setRotationLocked(locked: bool): string {
            root.setRotationLocked(locked);
            return locked ? "locked" : "unlocked";
        }

        function toggleRotationLock(): string {
            root.setRotationLocked(!root.rotationLocked);
            return root.rotationLocked ? "locked" : "unlocked";
        }

        function status(): string {
            return JSON.stringify({
                "keyboardBackend": root.keyboardBackend,
                "keyboardAvailable": root.keyboardAvailable,
                "keyboardVisible": root.keyboardVisible,
                "keyboardRunning": osk.running,
                "tabletMode": root.tabletMode,
                "physicalKeyboard": root.physicalKeyboard,
                "tabletModeManaged": root.pluginService?.loadPluginState(root.pluginId, "tabletModeManaged", false) ?? false,
                "inputTier": root.inputTier,
                "libinputWatcherEnabled": root.libinputWatcherEnabled,
                "activeWatcherMode": root.activeWatcherMode,
                "inputWatcherRunning": inputWatcher.running,
                "externalKeyboards": root.externalKeyboardNodes,
                "rotationActive": root.rotationActive,
                "rotationOutput": root.rotationOutput
            });
        }
    }

    Component.onCompleted: detectInputTier()

    Component.onDestruction: {
        stopInputWatcher();
        osk.running = false;
        if (_sensorSubscription)
            stopRotation();
    }
}
